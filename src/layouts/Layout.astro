---
import "@fontsource-variable/gabarito";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "VV Studios Changelog",
	description = "VV Studios website and booking changelog.",
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href="/icons/studio/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/icons/studio/favicon-16x16.png" />
		<link rel="shortcut icon" href="/icons/studio/favicon.ico" />
		<link rel="apple-touch-icon" href="/icons/studio/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="mx-auto flex min-h-dvh max-w-3xl flex-col px-6 py-12 sm:px-8 sm:py-16">
			<header class="mb-12 border-b border-border pb-8">
				<h1 class="mt-2 text-3xl text-primary font-semibold tracking-tight sm:text-4xl">
					VV Studios Changelog
				</h1>
				<p class="mt-3 max-w-xl">
					A history of what changed for clients and studio staff.
					Behind-the-scenes technical work is left out.
				</p>
				<p class="mt-3 max-w-xl text-xs text-muted-foreground">
					Dates may not be accurate.
				</p>
				<a
					href="https://vertigovisuals.au"
					class="mt-6 inline-flex text-sm text-primary transition hover:underline"
				>
					vertigovisuals.au →
				</a>
			</header>
			<main class="flex-1">
				<slot />
			</main>
			<footer class="mt-16 border-t border-border pt-8 text-sm text-muted-foreground">
				<p>Made by Leo Zhou</p>
			</footer>
		</div>
	</body>
</html>
